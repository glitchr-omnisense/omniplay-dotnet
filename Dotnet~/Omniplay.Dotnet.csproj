<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Runtime folder's sources as a .NET library (netstandard2.1: Unity, Godot's C#, any .NET).
       It sits in Dotnet~, a folder Unity ignores, so that the UPM package never sees a project, bin or obj. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>Omniplay</AssemblyName>
    <RootNamespace>Omniplay</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageId>Omniplay.Dotnet</PackageId>
    <Version>1.0.0</Version>
    <Authors>Marco Meyer</Authors>
    <Description>omnisense/omniplay inside a .NET game server: verify the tickets players present, mint them, send the server's heartbeats. netstandard2.1, no dependency, no Unity.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/glitchr-omnisense/omniplay-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/glitchr-omnisense/omniplay-dotnet</PackageProjectUrl>
    <PackageTags>omniplay;game-server;ticket;hmac;heartbeat;multiplayer</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>https://github.com/glitchr-omnisense/omniplay-dotnet/blob/1.x/CHANGELOG.md</PackageReleaseNotes>
    <Copyright>Copyright (c) 2026 Marco Meyer</Copyright>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Runtime/**/*.cs" />
  </ItemGroup>
</Project>
